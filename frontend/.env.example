# Backend API base URL
VITE_API_URL=http://127.0.0.1:8000
# Deployed contract address (from blockchain/scripts/deploy.js output).
# If empty, on-chain write buttons show a setup message instead of failing silently.
VITE_CONTRACT_ADDRESS=
# Hardhat local RPC (for MetaMask network setup instructions)
VITE_RPC_URL=http://127.0.0.1:8545
